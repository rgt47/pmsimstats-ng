+#' Carryover decay
+#'
+#' \code{carryoverdecay} is the fraction of the drug effect remaining a time \code{tsd}
+#' after discontinuation: exponential, \code{(1/2)^(tsd/t_half)}, when \code{k = 1}, and
+#' Weibull with the same half-life, \code{exp(-(log(2)^(1/k)*tsd/t_half)^k)}, otherwise.
+#' It is 0 when \code{t_half} is 0.
+#'
+#' @param tsd Time since discontinuation
+#' @param t_half Half-life of the carryover effect
+#' @param k Weibull shape (1: exponential)
+#' @keywords internal
+carryoverdecay<-function(tsd,t_half,k=1){
+  if(t_half<=0) return(rep(0,length(tsd)))
+  # k = 1 keeps the published expression, so the default reproduces it bit for bit
+  if(k==1) return((1/2)^(tsd/t_half))
+  exp(-(log(2)^(1/k)*tsd/t_half)^k)
 }
