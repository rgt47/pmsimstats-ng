+#' Monotone MCAR or MAR dropout
+#'
+#' \code{censordropout} implements the \code{type = "MCAR"} and \code{type = "MAR"}
+#' mechanisms of \link{censordata}, as in the pmsimstats-ng stress test.
+#'
+#' @param dat dat file as produced by \code{generateData}, with \code{path} and
+#'   \code{replicate} columns as added by \link{generateSimulatedResults}
+#' @param labels The timepoint names
+#' @param rate Expected fraction of participants who drop out
+#' @param type \code{"MCAR"} or \code{"MAR"}
+#' @return \code{dat} with the timepoints from dropout onward set to \code{NA}
+#' @keywords internal
+censordropout<-function(dat,labels,rate,type){
+  dat<-copy(dat)
+  nv<-length(labels)
+  dropat<-rep(Inf,nrow(dat))
+  if(type=="MCAR"){
+    hit<-runif(nrow(dat))<rate
+    dropat[hit]<-sample(3:nv,sum(hit),replace=TRUE)
+  }else{
+    # The stress test standardizes the previous score and solves the intercept within
+    # each simulated trial and path, so the same is done for each path of each replicate
+    Y<-as.matrix(dat[,labels,with=FALSE])
+    grp<-if(all(c("path","replicate")%in%names(dat))) paste(dat$path,dat$replicate) else rep(1,nrow(dat))
+    for(gg in unique(grp)){
+      ii<-which(grp==gg)
+      zp<-scale(Y[ii,2:(nv-1),drop=FALSE])
+      pdrop<-function(a) mean(1-apply(1-plogis(a+zp),1,prod))
+      a<-uniroot(function(a) pdrop(a)-rate,c(-15,5))$root
+      h<-plogis(a+zp)
+      u<-matrix(runif(length(h)),nrow(h))
+      for(k in seq_along(ii)){
+        j<-which(u[k,]<h[k,])
+        if(length(j)) dropat[ii[k]]<-j[1]+2
+      }
+    }
+  }
+  for(itp in 3:nv){
+    set(dat,i=which(dropat<=itp),j=labels[itp],value=NA_real_)
+  }
   return(dat)
 }
