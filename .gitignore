# Jobs fetched from the simulation server (simrun fetch)
analysis/remote_runs/

# Per-replicate checkpoint cache written by carryover-sensitivity driver
# scripts (ck_dir <- file.path(OUT_DIR, 'trials'); one .rds per rep, used
# only to resume an interrupted run). Regeneratable from the script +
# seed; the small all.rds/summary.rds/meta.rds results alongside each
# trials/ dir are the actual output and stay tracked. 60500 files as of
# 2026-10-26, most of a 78000-file repo -- this is what made `git clone`
# slow on Expanse.
analysis/data/carryover-sensitivity/*/trials/
# Same pattern for the paper 03 referee rerun
# (analysis/scripts/latent-class-mixture-application/12-referee-rerun.R).
analysis/data/latent-class-mixture-application/*/trials/

# Same checkpoint-cache pattern under analysis/data/quick-sim, used by
# the quick-sim driver scripts under analysis/scripts/quick-sim/* (and
# a few scripts elsewhere that share its output tree): each script
# skips recomputing a cell/chunk whose .rds or .csv already exists
# (e.g. 04-power-simulation.R, 11-strawman-stress-test.R,
# 12-common-grid-contrast.R, 01-e9-closed-form.R, 58-mc-check.R), under
# one of three naming conventions -- `cells-*/`, `sets-reps*/`,
# `mc-cells-reps<N>/` as a leaf directory, or `<N>-mc-chunks/` matching
# a script number. The small summary-*.csv/replicates-*.rds/
# decision-*.csv files that sit alongside these directories are the
# actual output and stay tracked. 15123 of 15419 quick-sim files as of
# 2026-10-27; same git-clone bloat as the carryover-sensitivity fix
# above, left alone at the time because of its less uniform naming.
analysis/data/quick-sim/**/cells-*/
analysis/data/quick-sim/**/sets-reps*/
analysis/data/quick-sim/**/mc-cells-reps*/
analysis/data/quick-sim/**/*-mc-chunks/
# Per-replicate checkpoints of 19-g9-planning-and-fig4b.R.
analysis/data/quick-sim/carryover-closed-form/g9-planning/**/trials/

